{
  "name": "zalatte-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run lint",
    "build": "npm run build --prefix frontend && node scripts/publish-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:ui",
    "preview": "npm run preview --prefix frontend -- --host 127.0.0.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
